      "titre": "Périodes de trois signaux",
      "type": "exemple_cours",
      "enonce": "Trois signaux périodiques : tension $v$ en créneaux (axe en µs), tension $u$ en impulsions de 24 V (axe en ms), courant $i$ triangulaire jusqu'à 2 mA (axe en s). Les motifs élémentaires sont surlignés.",
      "donnees": [],
      "etapes": [
        {
          "question": "Période de v ?",
          "formules": [],
          "reponse": {
            "valeur": 8e-07,
            "unite": "s",
            "texte": "T = 0,8 µs"
          }
        },
        {
          "question": "Période de u ?",
          "formules": [],
          "reponse": {
            "valeur": 0.05,
            "unite": "s",
            "texte": "T = 50 ms"
          }
        },
        {
          "question": "Période de i ?",
          "formules": [],
          "reponse": {
            "valeur": 30,
            "unite": "s",
            "texte": "T = 30 s"
          }
        }
      ],
      "source": {
        "fichier": "A1-Ch03-p02.pdf",
        "page": 1,
        "zone": "document 2, exemples"
      },
      "origine": "scan",
      "ajouts": [],
      "à_vérifier": false,
      "note": "Les formes d'onde ne sont pas redessinées ; seules les périodes écrites sous chaque graphique sont reprises."
    },
    {
      "id": "ch03.ex-frequences",
      "titre": "Fréquences des trois signaux du document 2",
      "type": "exemple_cours",
      "enonce": "À partir des périodes du document 2, calculer les fréquences.",
      "donnees": [
        {
          "code": "Tv",
          "symbole": "T_v",
          "valeur": 8e-07,
          "unite": "s"
        },
        {
          "code": "Tu",
          "symbole": "T_u",
          "valeur": 0.05,
          "unite": "s"
        },
        {
          "code": "Ti",
          "symbole": "T_i",
          "valeur": 30,
          "unite": "s"
        }
      ],
      "etapes": [
        {
          "question": "Fréquence de v ?",
          "formules": [
            "ch03.frequence"
          ],
          "calcul": "1/Tv",
          "reponse": {
            "valeur": 1250000,
            "unite": "Hz",
            "texte": "f = 1/0,8 µs = 1,25 MHz"
          }
        },
        {
          "question": "Fréquence de u ?",
          "formules": [
            "ch03.frequence"
          ],
          "calcul": "1/Tu",
          "reponse": {
            "valeur": 20,
            "unite": "Hz",
            "texte": "f = 1/50 ms = 20 Hz"
          }
        },
        {
          "question": "Fréquence de i ?",
          "formules": [
            "ch03.frequence"
          ],
          "calcul": "1/Ti",
          "reponse": {
            "valeur": 0.0333,
            "unite": "Hz",
            "texte": "f = 1/30 s ≈ 0,033 Hz"
          }
        }
      ],
      "source": {
        "fichier": "A1-Ch03-p02.pdf",
        "page": 1,
        "zone": "document 2"
      },
      "origine": "déduit",
      "ajouts": [],
      "à_vérifier": false,
      "note": "Les fréquences ne sont pas calculées dans le polycopié : application directe de f = 1/T aux périodes données."
    },
    {
      "id": "ch03.ex-efficace",
      "titre": "Sens physique de la valeur efficace",
      "type": "exemple_cours",
      "enonce": "Un courant sinusoïdal a une valeur maximale de 2 A. Quelle est sa valeur efficace, et que signifie-t-elle ?",
      "donnees": [
        {
          "code": "Imax",
          "symbole": "\\hat{I}",
          "valeur": 2,
          "unite": "A"
        }
      ],
      "etapes": [
        {
          "question": "Valeur efficace mesurée ?",
          "formules": [
            "ch03.efficace"
          ],
          "calcul": "Imax/Math.sqrt(2)",
          "reponse": {
            "valeur": 1.41,
            "unite": "A",
            "texte": "I = 1,41 A : ce courant fournirait à une résistance la même puissance qu'un continu parfaitement lissé de 1,41 A."
          }
        }
      ],
      "source": {
        "fichier": "A1-Ch03-p02.pdf",
        "page": 1,
        "zone": "document 3"
      },
