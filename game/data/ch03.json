    },
    {
      "id": "ch03.valeur-moyenne",
      "nom": "Valeur moyenne",
      "definition": "Grandeur mesurée pour un signal continu. Notée par une minuscule entre crochets : <u>, <i>.",
      "source": {
        "fichier": "A1-Ch03-p02.pdf",
        "page": 1,
        "zone": "document 3"
      },
      "origine": "scan",
      "ajouts": [],
      "à_vérifier": false
    },
    {
      "id": "ch03.valeur-efficace",
      "nom": "Valeur efficace",
      "definition": "Grandeur mesurée pour un signal alternatif (valeur moyenne nulle). Notée par une majuscule : U, I. Définition physique : l'équivalent du continu parfaitement lissé du point de vue de la puissance.",
      "source": {
        "fichier": "A1-Ch03-p02.pdf",
        "page": 1,
        "zone": "document 3"
      },
      "origine": "scan",
      "ajouts": [],
      "à_vérifier": false
    },
    {
      "id": "ch03.multimetre-non-rms",
      "nom": "Multimètre « non RMS »",
      "definition": "DC : valeur moyenne correcte pour tout signal périodique. AC : valeur efficace correcte seulement si le signal est sinusoïdal.",
      "source": {
        "fichier": "A1-Ch03-p02.pdf",
        "page": 1,
        "zone": "document 4"
      },
      "origine": "scan",
      "ajouts": [],
      "à_vérifier": false
    },
    {
      "id": "ch03.multimetre-rms",
      "nom": "Multimètre « RMS »",
      "definition": "DC : valeur moyenne correcte pour tout signal périodique. AC : valeur efficace correcte seulement si le signal est alternatif.",
      "source": {
        "fichier": "A1-Ch03-p02.pdf",
        "page": 1,
        "zone": "document 4"
      },
      "origine": "scan",
      "ajouts": [],
      "à_vérifier": false
    },
    {
      "id": "ch03.multimetre-trms",
      "nom": "Multimètre TRMS (True RMS, valeur efficace vraie)",
      "definition": "Mesure correctement valeur moyenne et valeur efficace de tout signal périodique. DC : valeur moyenne ; AC : valeur efficace de la composante alternative (rarement utilisée) ; AC+DC : valeur efficace du signal complet (celle qui nous intéresse).",
      "source": {
        "fichier": "A1-Ch03-p03.pdf",
        "page": 1,
        "zone": "document 5"
      },
      "origine": "scan",
      "ajouts": [],
      "à_vérifier": false
    },
    {
      "id": "ch03.composantes",
      "nom": "Composantes continue et alternative",
      "definition": "Tout signal périodique u se décompose en une composante continue égale à sa valeur moyenne <u> et une composante alternative (ondulation) de valeur moyenne nulle.",
      "source": {
        "fichier": "A1-Ch03-p03.pdf",
        "page": 1,
        "zone": "document 5"
      },
      "origine": "scan",
      "ajouts": [],
      "à_vérifier": false
    },
    {
      "id": "ch03.limite-frequence",
      "nom": "Limite en fréquence des multimètres",
      "definition": "Tous les multimètres (non RMS, RMS, TRMS) ont une limite de mesure en fréquence, donnée par la notice du constructeur.",
      "source": {
        "fichier": "A1-Ch03-p03.pdf",
        "page": 1,
        "zone": "document 5, remarque"
      },
      "origine": "scan",
      "ajouts": [],
      "à_vérifier": false
    },
    {
      "id": "ch03.notations",
      "nom": "Écriture normalisée des grandeurs",
      "definition": "Instantanée : u ou u(t), i ou i(t). Efficace : U, I. Maximale : Û, Î. Minimale : Ǔ, Ǐ. Moyenne : <u> ou <u(t)>, <i> ou <i(t)>.",
      "source": {
        "fichier": "A1-Ch03-p03.pdf",
        "page": 1,
        "zone": "document 6"
      },
      "origine": "scan",
      "ajouts": [],
      "à_vérifier": false
    }
  ],
  "formules": [
    {
      "id": "ch03.frequence",
      "site_id": "ch03Frequence",
      "nom": "Fréquence et période",
      "latex": "f = \\dfrac{1}{T}",
      "variables": [
        {
          "symbole": "f",
          "code": "f",
          "signification": "fréquence",
          "unite": "Hz"
        },
        {
          "symbole": "T",
          "code": "T",
          "signification": "période (durée d'un motif élémentaire)",
          "unite": "s"
        }
      ],
      "conditions": "Grandeur périodique. f en Hz, T en s.",
      "calcul": {
        "cible": "f",
        "expression": "1/T"
      },
      "source": {
        "fichier": "A1-Ch03-p02.pdf",
        "page": 1,
        "zone": "document 2, encadré"
      },
      "origine": "scan",
      "ajouts": [],
      "à_vérifier": false
    },
    {
      "id": "ch03.efficace",
      "site_id": "ch03Efficace",
      "nom": "Valeur efficace (définition mathématique)",
      "latex": "U = \\sqrt{\\langle u^2 \\rangle}",
      "variables": [
        {
          "symbole": "U",
          "code": "U",
          "signification": "valeur efficace",
          "unite": "V"
        },
        {
          "symbole": "\\langle u^2 \\rangle",
          "code": "moyU2",
          "signification": "valeur moyenne du carré de la tension instantanée",
          "unite": "V²"
        }
      ],
      "conditions": "Définition mathématique ; la définition physique à retenir : équivalent du continu parfaitement lissé du point de vue de la puissance.",
      "calcul": {
        "cible": "U",
        "expression": "Math.sqrt(moyU2)"
      },
      "source": {
        "fichier": "A1-Ch03-p02.pdf",
        "page": 1,
        "zone": "document 3"
      },
      "origine": "scan",
      "ajouts": [
        "unités (V, V²) : non écrites sur le scan"
      ],
      "à_vérifier": false
    },
    {
      "id": "ch03.decomposition",
      "site_id": "ch03Decomposition",
      "nom": "Composantes continue et alternative",
      "latex": "u = \\langle u \\rangle + u_{ond}",
      "variables": [
        {
          "symbole": "u",
          "code": "u",
          "signification": "valeur instantanée du signal complet",
          "unite": "V"
        },
        {
          "symbole": "\\langle u \\rangle",
          "code": "moyU",
          "signification": "composante continue (valeur moyenne)",
          "unite": "V"
        },
        {
          "symbole": "u_{ond}",
          "code": "uond",
          "signification": "composante alternative (ondulation), de valeur moyenne nulle",
          "unite": "V"
        }
      ],
      "conditions": "Tout signal périodique.",
      "calcul": {
        "cible": "u",
        "expression": "moyU+uond"
      },
      "source": {
        "fichier": "A1-Ch03-p03.pdf",
        "page": 1,
        "zone": "document 5, figure"
      },
      "origine": "déduit",
      "ajouts": [
        "unité V : non écrite sur le scan"
      ],
      "à_vérifier": false,
      "note": "L'égalité n'est pas écrite telle quelle : c'est la mise en équation de la figure « signal complet = composante continue + composante alternative »."
    }
  ],
