        "page": 1,
        "zone": "document 2"
      },
      "origine": "scan",
      "ajouts": [],
      "à_vérifier": false
    },
    {
      "id": "ch03.def-frequence",
      "nom": "Fréquence f",
      "definition": "Nombre de périodes se produisant en une seconde, notée f, en hertz (Hz).",
