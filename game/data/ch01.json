  "exemples": [
    {
      "id": "ch01.ex-diviseur",
      "titre": "Diviseur de tension à trois résistances",
      "type": "exemple_cours",
      "enonce": "Trois résistances $R_1$, $R_2$, $R_3$ en série sont soumises à la tension $E$. $U$ est la tension aux bornes de $R_1$, $V$ celle aux bornes de $R_2$ et $R_3$, $W$ celle aux bornes de $R_3$.",
      "donnees": [],
      "etapes": [
        {
          "question": "Exprimer U.",
          "formules": [
            "ch01.diviseur"
          ],
          "reponse": {
            "texte": "U = R_1/(R_1 + R_2 + R_3) × E"
          }
        },
        {
          "question": "Exprimer V.",
          "formules": [
            "ch01.diviseur"
          ],
          "reponse": {
            "texte": "V = (R_2 + R_3)/(R_1 + R_2 + R_3) × E"
          }
        },
        {
          "question": "Exprimer W en fonction de E.",
          "formules": [
            "ch01.diviseur"
          ],
          "reponse": {
            "texte": "W = R_3/(R_1 + R_2 + R_3) × E"
          }
        },
        {
          "question": "Exprimer W en fonction de V.",
          "formules": [
            "ch01.diviseur-partiel"
          ],
          "reponse": {
            "texte": "W = R_3/(R_2 + R_3) × V"
          }
        }
      ],
      "source": {
        "fichier": "A1-Ch01-p03.pdf",
        "page": 1,
        "zone": "§ 6, exemple"
      },
      "origine": "scan",
      "ajouts": [],
      "à_vérifier": false,
      "note": "Exemple littéral, sans valeurs numériques."
    },
    {
      "id": "ch01.ex-superposition",
      "titre": "Calcul d'une tension par superposition",
      "type": "exemple_cours",
      "enonce": "Trois branches en dérivation : $E$ en série avec $R_1$ ; une source de courant $I$ en série avec $R_2$ ; la résistance $R$, aux bornes de laquelle on cherche $U$.",
      "donnees": [
        {
          "code": "R",
          "symbole": "R",
          "valeur": 50,
          "unite": "Ω"
        },
        {
          "code": "R1",
          "symbole": "R_1",
          "valeur": 30,
          "unite": "Ω"
        },
        {
          "code": "R2",
          "symbole": "R_2",
          "valeur": 30,
          "unite": "Ω"
        },
        {
          "code": "E",
          "symbole": "E",
          "valeur": 10,
          "unite": "V"
        },
        {
          "code": "I",
          "symbole": "I",
          "valeur": 0.5,
          "unite": "A"
        }
      ],
      "etapes": [
        {
          "question": "Étape 1 : E seule (I remplacée par un circuit ouvert). Calculer U'.",
          "formules": [
            "ch01.eteindre-sources",
            "ch01.diviseur"
          ],
          "calcul": "R/(R+R1)*E",
          "reponse": {
            "valeur": 6.25,
            "unite": "V",
            "texte": "U' = 50/(50 + 30) × 10 = 6,25 V"
          },
          "note": "Le polycopié écrit « U' = 6,25A » : erreur d'unité, c'est une tension."
        },
        {
          "question": "Étape 2 : I seule (E remplacée par un court-circuit). Calculer la résistance équivalente à R et R_1 en parallèle.",
          "formules": [
            "ch01.eteindre-sources",
            "ch01.deux-derivation"
          ],
          "calcul": "R*R1/(R+R1)",
          "reponse": {
            "valeur": 18.75,
            "unite": "Ω",
            "texte": "R_eq = 50 × 30/(50 + 30) = 18,75 Ω"
          }
        },
        {
          "question": "Étape 2 (suite) : calculer U''.",
          "formules": [
            "ch01.ohm"
          ],
          "calcul": "R*R1/(R+R1)*I",
          "reponse": {
            "valeur": 9.375,
            "unite": "V",
            "texte": "U'' = 18,75 × 0,5 = 9,38 V"
          }
        },
        {
          "question": "Étape 3 : en déduire U.",
          "formules": [
            "ch01.superposition"
          ],
          "calcul": "R/(R+R1)*E + R*R1/(R+R1)*I",
          "reponse": {
            "valeur": 15.625,
            "unite": "V",
            "texte": "U = 6,25 + 9,38 = 15,6 V"
          }
        }
      ],
      "source": {
        "fichier": "A1-Ch01-p03.pdf",
        "page": 1,
        "zone": "§ 7, exemple ; résolution sur A1-Ch01-p04.pdf"
      },
      "origine": "scan",
      "ajouts": [],
      "à_vérifier": false
    }
  ],
