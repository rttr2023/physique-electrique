{
  "id": "ch01",
  "annee": 1,
  "numero": 1,
  "titre": "Le cas particulier du régime continu",
  "sources": [
    "A1-Ch01-p01.pdf",
    "A1-Ch01-p02.pdf",
    "A1-Ch01-p03.pdf",
    "A1-Ch01-p04.pdf"
  ],
  "notions": [
    {
      "id": "ch01.regime-continu",
      "nom": "Régime continu",
      "definition": "Cas particulier des régimes variables quelconques : les valeurs instantanées sont constantes au cours du temps. Toutes les lois du régime variable s'y appliquent.",
      "source": {
        "fichier": "A1-Ch01-p01.pdf",
        "page": 1,
        "zone": "§ 1"
      },
      "origine": "scan",
      "ajouts": [],
      "à_vérifier": false
    },
    {
      "id": "ch01.majuscules",
      "nom": "Notation en majuscules",
      "definition": "En régime continu, seule l'écriture change : on note les grandeurs en majuscules (U, I) pour distinguer ce régime particulier.",
      "source": {
        "fichier": "A1-Ch01-p01.pdf",
        "page": 1,
        "zone": "§ 1"
      },
      "origine": "scan",
      "ajouts": [],
      "à_vérifier": false
    },
    {
      "id": "ch01.condensateur-continu",
      "nom": "Condensateur en régime continu",
      "definition": "Un condensateur est équivalent à un circuit ouvert en régime continu (I = 0).",
      "source": {
        "fichier": "A1-Ch01-p01.pdf",
        "page": 1,
        "zone": "§ 2, tableau"
      },
      "origine": "scan",
      "ajouts": [],
      "à_vérifier": false
    },
    {
      "id": "ch01.bobine-continu",
      "nom": "Bobine en régime continu",
      "definition": "Une inductance est équivalente à un court-circuit (un fil) en régime continu (U = 0).",
      "source": {
        "fichier": "A1-Ch01-p01.pdf",
        "page": 1,
        "zone": "§ 2, tableau"
      },
      "origine": "scan",
      "ajouts": [],
      "à_vérifier": false
    },
    {
      "id": "ch01.assoc-serie",
      "nom": "Association série",
      "definition": "Des résistances sont associées en série si elles sont traversées par le même courant.",
      "source": {
        "fichier": "A1-Ch01-p01.pdf",
        "page": 1,
        "zone": "§ 3"
      },
      "origine": "scan",
      "ajouts": [],
      "à_vérifier": false
    },
    {
      "id": "ch01.assoc-derivation",
      "nom": "Association en dérivation",
      "definition": "Des résistances sont associées en dérivation si elles sont soumises à la même tension.",
      "source": {
        "fichier": "A1-Ch01-p01.pdf",
        "page": 1,
        "zone": "§ 3"
      },
      "origine": "scan",
      "ajouts": [],
      "à_vérifier": false
    },
    {
      "id": "ch01.dipole-actif",
      "nom": "Dipôle actif",
      "definition": "Dipôle pouvant fonctionner en générateur (panneaux solaires, piles…). Certains sont réversibles : générateur et récepteur (batteries, MCC…).",
      "source": {
        "fichier": "A1-Ch01-p02.pdf",
        "page": 1,
        "zone": "§ 4"
      },
      "origine": "scan",
      "ajouts": [],
      "à_vérifier": false
    },
    {
      "id": "ch01.met",
      "nom": "Modèle équivalent de Thévenin (MET)",
      "definition": "Vu entre ses bornes A et B, un dipôle actif est équivalent à une source de tension E_TH en série avec une résistance R_TH.",
      "source": {
        "fichier": "A1-Ch01-p02.pdf",
        "page": 1,
        "zone": "§ 4, schéma"
      },
      "origine": "scan",
      "ajouts": [],
      "à_vérifier": false
    },
    {
      "id": "ch01.eth",
      "nom": "Détermination de E_TH",
      "definition": "E_TH est égale à la tension entre A et B lorsque le dipôle (D) est déconnecté (tension à vide).",
      "source": {
        "fichier": "A1-Ch01-p02.pdf",
        "page": 1,
        "zone": "§ 4"
      },
      "origine": "scan",
      "ajouts": [],
      "à_vérifier": false
    },
    {
      "id": "ch01.rth",
      "nom": "Détermination de R_TH",
      "definition": "R_TH est la résistance équivalente vue des points A et B lorsque toutes les sources sont éteintes.",
      "source": {
        "fichier": "A1-Ch01-p02.pdf",
        "page": 1,
        "zone": "§ 4"
      },
      "origine": "scan",
      "ajouts": [],
      "à_vérifier": false
    },
    {
      "id": "ch01.eteindre-sources",
      "nom": "Éteindre une source",
      "definition": "Source de tension éteinte → remplacée par un court-circuit. Source de courant éteinte → remplacée par un circuit ouvert.",
      "source": {
        "fichier": "A1-Ch01-p02.pdf",
        "page": 1,
        "zone": "§ 4, « En pratique »"
      },
      "origine": "scan",
      "ajouts": [],
      "à_vérifier": false
    },
    {
      "id": "ch01.convention-generateur",
      "nom": "Convention générateur",
      "definition": "I et U sont fléchés dans le même sens. Pour le générateur (E, r) : E fléchée dans le sens de U, rI en sens opposé.",
      "source": {
        "fichier": "A1-Ch01-p02.pdf",
        "page": 1,
        "zone": "§ 5, schéma générateur"
      },
      "origine": "scan",
      "ajouts": [],
      "à_vérifier": false
    },
    {
      "id": "ch01.convention-recepteur",
      "nom": "Convention récepteur",
      "definition": "I et U sont fléchés en sens opposés. Pour le récepteur (E, r) : E et rI sont fléchées dans le sens de U.",
      "source": {
        "fichier": "A1-Ch01-p02.pdf",
        "page": 1,
        "zone": "§ 5, schéma récepteur"
      },
      "origine": "scan",
      "ajouts": [],
      "à_vérifier": false
    },
    {
      "id": "ch01.principe-diviseur",
      "nom": "Diviseur de tension",
      "definition": "Calcul d'une tension exclusivement aux bornes de résistances en série : (somme des résistances de la partie / somme totale des résistances) × tension aux bornes de l'ensemble.",
      "source": {
        "fichier": "A1-Ch01-p03.pdf",
        "page": 1,
        "zone": "§ 6"
      },
      "origine": "scan",
      "ajouts": [],
      "à_vérifier": false
    },
    {
      "id": "ch01.principe-superposition",
      "nom": "Principe de superposition",
      "definition": "Dans un circuit linéaire à plusieurs sources indépendantes, le courant (ou la tension) d'une branche est la somme algébrique des courants (ou tensions) obtenus quand chaque source agit seule, les autres étant éteintes.",
      "source": {
        "fichier": "A1-Ch01-p03.pdf",
        "page": 1,
        "zone": "§ 7, énoncé encadré"
      },
      "origine": "scan",
      "ajouts": [],
      "à_vérifier": false
    }
  ],
  "formules": [
    {
      "id": "ch01.ohm",
      "site_id": "ch01Ohm",
      "nom": "Loi d'Ohm (résistance)",
      "latex": "U = R I",
      "variables": [
        {
          "symbole": "U",
          "code": "U",
          "signification": "tension aux bornes de la résistance",
          "unite": "V"
        },
        {
          "symbole": "R",
          "code": "R",
          "signification": "résistance",
          "unite": "Ω"
        },
        {
          "symbole": "I",
          "code": "I",
          "signification": "intensité du courant qui la traverse",
          "unite": "A"
        }
      ],
      "conditions": "Régime continu, convention récepteur (I et U fléchés en sens opposés).",
      "calcul": {
        "cible": "U",
        "expression": "R*I"
      },
      "source": {
        "fichier": "A1-Ch01-p01.pdf",
        "page": 1,
        "zone": "§ 2, tableau"
      },
      "origine": "scan",
      "ajouts": [
        "unités V, Ω, A : non écrites sur le scan"
      ],
      "à_vérifier": false
    },
    {
      "id": "ch01.cond-continu",
      "site_id": "ch01CondDC",
