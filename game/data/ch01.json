      "variables": [
        {
          "symbole": "I",
          "code": "I",
          "signification": "courant traversant le condensateur",
          "unite": "A"
        }
      ],
      "conditions": "Régime continu : u constante donc du/dt = 0 dans i = C du/dt. Le condensateur est un circuit ouvert.",
      "source": {
        "fichier": "A1-Ch01-p01.pdf",
