    {
      "id": "ch04.courant-manuscrit",
      "site_id": null,
      "nom": "Courant en ligne (annotation)",
      "latex": "I = \\dfrac{P}{U \\cos\\varphi}",
      "variables": [
        {
          "symbole": "I",
          "code": "I",
          "signification": "courant efficace en ligne",
          "unite": "A"
        },
        {
          "symbole": "P",
          "code": "P",
          "signification": "puissance active",
          "unite": "W"
        },
        {
          "symbole": "U",
          "code": "U",
          "signification": "tension efficace",
          "unite": "V"
        },
        {
          "symbole": "\\varphi",
          "code": "phi",
          "signification": "déphasage",
          "unite": "rad"
        }
      ],
      "conditions": "À P et U fixés, I augmente quand cos φ diminue (φ s'éloigne de 0) : c'est l'effet du document 2.",
      "calcul": {
        "cible": "I",
        "expression": "P/(U*Math.cos(phi))"
      },
      "source": {
        "fichier": "A1-Ch04-p04.pdf",
