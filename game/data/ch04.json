    },
    {
      "id": "ch04.puissance-manuscrit",
      "site_id": null,
      "nom": "Puissance active (annotation)",
      "latex": "P = U I \\cos\\varphi",
      "variables": [
        {
          "symbole": "P",
          "code": "P",
          "signification": "puissance active",
          "unite": "W"
        },
        {
          "symbole": "U",
          "code": "U",
          "signification": "tension efficace",
          "unite": "V"
        },
        {
          "symbole": "I",
          "code": "I",
          "signification": "courant efficace",
          "unite": "A"
        },
        {
          "symbole": "\\varphi",
          "code": "phi",
          "signification": "déphasage",
          "unite": "rad"
        }
      ],
      "conditions": "Régime sinusoïdal (vue au chapitre 6).",
      "calcul": {
        "cible": "P",
        "expression": "U*I*Math.cos(phi)"
      },
      "source": {
        "fichier": "A1-Ch04-p04.pdf",
        "page": 1,
        "zone": "annotation manuscrite en bas de page"
