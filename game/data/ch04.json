{
  "id": "ch04",
  "annee": 1,
  "numero": 4,
  "titre": "Le déphasage courant/tension en régime sinusoïdal",
  "sources": [
    "A1-Ch04-p01.pdf",
    "A1-Ch04-p02.pdf",
    "A1-Ch04-p03.pdf",
    "A1-Ch04-p04.pdf"
  ],
  "notions": [
    {
      "id": "ch04.dephasage",
      "nom": "Déphasage φ",
      "definition": "Sans autre précision, φ est le déphasage du courant par rapport à la tension. On peut aussi l'appeler retard du courant sur la tension.",
      "source": {
        "fichier": "A1-Ch04-p03.pdf",
        "page": 1,
        "zone": "annexe 1, document 1"
      },
      "origine": "scan",
      "ajouts": [],
      "à_vérifier": false
    },
    {
      "id": "ch04.signe-phi",
      "nom": "Signe du déphasage",
      "definition": "φ > 0 si i est en retard sur v (inductif) ; φ < 0 si i est en avance sur v (capacitif) ; φ = 0 si i et v sont en phase (purement résistif).",
      "source": {
        "fichier": "A1-Ch04-p03.pdf",
        "page": 1,
        "zone": "annexe 1, document 1, oscillogrammes"
      },
      "origine": "scan",
      "ajouts": [],
      "à_vérifier": false
    },
    {
      "id": "ch04.phi-nul-ideal",
      "nom": "φ = 0 : le cas idéal",
      "definition": "φ = 0 correspond à un minimum de courant en ligne pour une puissance reçue donnée. C'est le cas d'un chauffage résistif.",
      "source": {
        "fichier": "A1-Ch04-p03.pdf",
        "page": 1,
        "zone": "annexe 1, document 1"
      },
      "origine": "scan",
      "ajouts": [],
      "à_vérifier": false
    },
    {
      "id": "ch04.moteurs",
      "nom": "Systèmes avec moteurs",
      "definition": "Dès que les systèmes contiennent par exemple des moteurs, φ est supérieur à zéro.",
      "source": {
        "fichier": "A1-Ch04-p03.pdf",
        "page": 1,
        "zone": "annexe 1, document 1"
      },
      "origine": "scan",
      "ajouts": [],
      "à_vérifier": false
    },
    {
      "id": "ch04.industrie-inductive",
      "nom": "Installations industrielles inductives",
      "definition": "Les installations industrielles sont de type inductif : le déphasage du courant par rapport à la tension y est positif (courant en retard).",
      "source": {
        "fichier": "A1-Ch04-p03.pdf",
        "page": 1,
        "zone": "annexe 1, document 2"
      },
      "origine": "scan",
      "ajouts": [],
      "à_vérifier": false
    },
    {
      "id": "ch04.effet-dephasage",
      "nom": "Effet d'un déphasage",
      "definition": "Augmentation du courant en ligne pour un même apport d'énergie. Double surcoût : installation surdimensionnée (câbles plus gros…) et taxe du fournisseur d'énergie, qui supporte plus de pertes en ligne.",
      "source": {
        "fichier": "A1-Ch04-p03.pdf",
        "page": 1,
        "zone": "annexe 1, document 2"
      },
      "origine": "scan",
      "ajouts": [],
      "à_vérifier": false
    },
    {
      "id": "ch04.def-batterie",
      "nom": "Batterie de condensateurs",
      "definition": "Plusieurs condensateurs en parallèle ; sa capacité (F) est la somme des capacités. Seuls, ils feraient avancer le courant ; en parallèle sur une installation inductive, ils compensent tout ou partie du retard : φ se rapproche de zéro (mais peut devenir négatif).",
      "source": {
        "fichier": "A1-Ch04-p04.pdf",
        "page": 1,
        "zone": "annexe 1, document 3"
      },
      "origine": "scan",
      "ajouts": [],
      "à_vérifier": false
    },
    {
      "id": "ch04.compensation-souplesse",
      "nom": "Limites de la batterie fixe",
      "definition": "La batterie est calculée pour une utilisation donnée et manque de souplesse face aux variations d'activité. Solutions : corriger chaque système, ou compensations sophistiquées qui réagissent instantanément (plus coûteuses mais vite amorties).",
      "source": {
        "fichier": "A1-Ch04-p04.pdf",
        "page": 1,
        "zone": "annexe 1, document 3"
      },
      "origine": "scan",
      "ajouts": [],
      "à_vérifier": false
    },
    {
      "id": "ch04.decalage",
      "nom": "Décalage temporel Δt",
      "definition": "Décalage entre les 2 courbes v et i (entre 2 maxima, entre 2 passages par zéro de même nature…), en secondes. Mesuré avec les curseurs de Psim ou de l'oscilloscope.",
      "source": {
        "fichier": "A1-Ch04-p04.pdf",
        "page": 1,
        "zone": "annexe 1, document 4"
      },
      "origine": "scan",
      "ajouts": [],
      "à_vérifier": false
    },
    {
      "id": "ch04.produit-croix",
      "nom": "Du décalage au déphasage",
      "definition": "Produit en croix : une période T correspond à 2π rad (ou 360°), le décalage Δt correspond à |φ|. Le signe se lit ensuite : + si i est en retard sur v.",
      "source": {
        "fichier": "A1-Ch04-p04.pdf",
        "page": 1,
        "zone": "annexe 1, document 4"
      },
      "origine": "scan",
      "ajouts": [],
      "à_vérifier": false
    }
  ],
  "formules": [
    {
      "id": "ch04.phi-rad",
      "site_id": "ch04PhiRad",
      "nom": "Déphasage en radians",
      "latex": "|\\varphi| = \\dfrac{2\\pi \\times \\Delta t}{T}",
      "variables": [
        {
          "symbole": "|\\varphi|",
          "code": "phi",
          "signification": "valeur absolue du déphasage",
          "unite": "rad"
        },
        {
          "symbole": "\\Delta t",
          "code": "dt",
          "signification": "décalage temporel entre v et i",
          "unite": "s"
        },
        {
          "symbole": "T",
          "code": "T",
          "signification": "période",
          "unite": "s"
        }
      ],
      "conditions": "Δt mesuré entre 2 maxima ou 2 passages par zéro de même nature. Signe : + si i en retard sur v.",
      "calcul": {
        "cible": "phi",
        "expression": "2*Math.PI*dt/T"
      },
      "source": {
        "fichier": "A1-Ch04-p04.pdf",
        "page": 1,
        "zone": "annexe 1, document 4, encadré"
      },
      "origine": "scan",
      "ajouts": [],
      "à_vérifier": false
    },
    {
      "id": "ch04.phi-deg",
      "site_id": "ch04PhiDeg",
      "nom": "Déphasage en degrés",
      "latex": "|\\varphi| = \\dfrac{360 \\times \\Delta t}{T}",
      "variables": [
        {
          "symbole": "|\\varphi|",
          "code": "phi",
          "signification": "valeur absolue du déphasage",
          "unite": "°"
        },
        {
          "symbole": "\\Delta t",
          "code": "dt",
          "signification": "décalage temporel entre v et i",
          "unite": "s"
        },
        {
          "symbole": "T",
          "code": "T",
          "signification": "période",
          "unite": "s"
        }
      ],
      "conditions": "Même Δt et même T, en secondes.",
      "calcul": {
        "cible": "phi",
        "expression": "360*dt/T"
      },
      "source": {
        "fichier": "A1-Ch04-p04.pdf",
        "page": 1,
        "zone": "annexe 1, document 4, encadré"
      },
      "origine": "scan",
      "ajouts": [],
      "à_vérifier": false
    },
    {
      "id": "ch04.seuil",
      "site_id": "ch04Seuil",
      "nom": "Déphasage toléré par le fournisseur",
      "latex": "\\varphi < 0{,}38\\ \\text{rad}\\ (21{,}5^\\circ)",
      "variables": [
        {
          "symbole": "\\varphi",
          "code": "phi",
          "signification": "déphasage de l'installation",
          "unite": "rad"
        }
      ],
      "conditions": "En dessous, pas de surtaxe du fournisseur d'électricité.",
      "source": {
        "fichier": "A1-Ch04-p03.pdf",
