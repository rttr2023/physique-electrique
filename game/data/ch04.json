      ],
      "à_vérifier": false
    },
    {
      "id": "ch04.ecriture-temporelle",
      "site_id": "ch04Ecriture",
      "nom": "Représentation temporelle (annotation)",
      "latex": "i(t) = I\\sqrt{2}\\,\\sin(\\omega t + \\varphi) \\quad u(t) = U\\sqrt{2}\\,\\sin(\\omega t + \\varphi)",
      "variables": [
        {
          "symbole": "I, U",
          "code": "I",
          "signification": "valeurs efficaces",
          "unite": "A, V"
        },
        {
          "symbole": "\\omega",
          "code": "w",
          "signification": "pulsation",
          "unite": "rad/s"
        },
        {
          "symbole": "\\varphi",
          "code": "phi",
          "signification": "phase",
          "unite": "rad"
        }
      ],
      "conditions": "Notée « représentation temporelle » à la main.",
      "source": {
        "fichier": "A1-Ch04-p04.pdf",
        "page": 1,
        "zone": "annotation manuscrite en bas à droite"
      },
      "origine": "manuscrit",
      "ajouts": [],
      "à_vérifier": true,
      "note": "Les deux expressions manuscrites portent le même « + φ » : u et i seraient alors en phase. Il manque l'origine des phases (u ou i) et le signe. Le site a choisi v = V√2 sin(ωt) et i = I√2 sin(ωt − φ) (rappel hors polycopié). À confirmer."
    },
    {
      "id": "ch04.efficace-sinus",
      "site_id": "ch04Eff",
      "nom": "Valeur efficace d'une sinusoïde",
      "latex": "V = \\dfrac{V_{max}}{\\sqrt{2}}",
      "variables": [
        {
          "symbole": "V",
          "code": "V",
          "signification": "valeur efficace",
          "unite": "V"
        },
        {
          "symbole": "V_{max}",
          "code": "Vmax",
          "signification": "valeur maximale",
          "unite": "V"
        }
      ],
      "conditions": "Signal sinusoïdal uniquement. De même I = I_max/√2.",
      "calcul": {
        "cible": "V",
        "expression": "Vmax/Math.sqrt(2)"
      },
      "source": {
        "fichier": "A1-Ch04-p02.pdf",
        "page": 1,
        "zone": "éléments de réponse (72 V → 50,9 V ; 0,7 A → 0,495 A)"
