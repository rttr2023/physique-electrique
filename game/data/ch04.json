        "zone": "annexe 1, document 2, dernière phrase"
      },
      "origine": "scan",
      "ajouts": [],
      "à_vérifier": true,
      "note": "Incohérence du polycopié : 0,38 rad × 180/π ≈ 21,8°, et non 21,5°. Quelle valeur retenir ?"
    },
    {
      "id": "ch04.batterie",
      "site_id": "ch04Batterie",
      "nom": "Capacité d'une batterie de condensateurs",
      "latex": "C = C_1 + C_2 + C_3 + \\cdots",
      "variables": [
        {
          "symbole": "C",
          "code": "C",
          "signification": "capacité de la batterie",
          "unite": "F"
        },
        {
          "symbole": "C_1",
          "code": "C1",
          "signification": "capacité d'un condensateur",
          "unite": "F"
        },
        {
          "symbole": "C_2",
          "code": "C2",
          "signification": "capacité d'un condensateur",
          "unite": "F"
        },
        {
          "symbole": "C_3",
          "code": "C3",
          "signification": "capacité d'un condensateur",
          "unite": "F"
        }
      ],
      "conditions": "Condensateurs connectés en parallèle.",
      "calcul": {
        "cible": "C",
        "expression": "C1+C2+C3"
      },
      "source": {
        "fichier": "A1-Ch04-p04.pdf",
        "page": 1,
        "zone": "annexe 1, document 3"
      },
      "origine": "déduit",
      "ajouts": [],
      "à_vérifier": false,
      "note": "Le polycopié l'écrit en phrase (« égale à la somme des capacités ») ; la formule en est la mise en équation."
    },
    {
      "id": "ch04.pulsation",
      "site_id": "ch04Freq",
      "nom": "Pulsation",
      "latex": "\\omega = 2\\pi f = \\dfrac{2\\pi}{T}",
      "variables": [
        {
          "symbole": "\\omega",
