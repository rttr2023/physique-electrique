  "exemples": [
    {
      "id": "ch05.ex-four",
      "titre": "Problématique : le four à induction",
      "type": "exemple_cours",
      "enonce": "Une phase d'un four à induction est modélisée par une inductance pure $L$ = 60 µH en série avec une résistance $r$ = 50 mΩ, sous $V$ = 230 V et 600 Hz. 1. Calculer l'impédance $Z$. 2. En déduire $I$. 3. Calculer le déphasage. Que faudra-t-il prévoir dans l'installation ?",
      "donnees": [
        { "code": "L", "symbole": "L", "valeur": 6e-5, "unite": "H" },
        { "code": "r", "symbole": "r", "valeur": 0.05, "unite": "Ω" },
        { "code": "V", "symbole": "V", "valeur": 230, "unite": "V" },
        { "code": "f", "symbole": "f", "valeur": 600, "unite": "Hz" }
      ],
      "etapes": [
        { "question": "Impédance Z du four ?", "formules": ["ch04.pulsation", "ch05.z-rl"], "calcul": "Math.sqrt(r*r+Math.pow(L*2*Math.PI*f,2))", "reponse": { "valeur": 0.2317, "unite": "Ω", "texte": "Lω = 60 × 10⁻⁶ × 2π × 600 ≈ 0,226 Ω ; Z = √(0,05² + 0,226²) ≈ 0,232 Ω" } },
        { "question": "Valeur efficace I du courant ?", "formules": ["ch05.ohm-sinus"], "calcul": "V/Math.sqrt(r*r+Math.pow(L*2*Math.PI*f,2))", "reponse": { "valeur": 993, "unite": "A", "texte": "I = 230 / 0,232 ≈ 993 A" } },
        { "question": "Déphasage ?", "formules": ["ch05.tan-rl"], "calcul": "Math.atan(L*2*Math.PI*f/r)*180/Math.PI", "reponse": { "valeur": 77.5, "unite": "°", "texte": "tan φ = 0,226 / 0,05 → φ ≈ 77,5°" } },
        { "question": "Que faudra-t-il prévoir ?", "formules": ["ch04.batterie"], "reponse": { "texte": "Déphasage très supérieur à 0,38 rad : prévoir une compensation (batterie de condensateurs, relèvement du facteur de puissance au ch06)." } }
      ],
      "source": { "fichier": "A1-Ch05-p01.pdf", "page": 1, "zone": "problématique et travail à effectuer" },
      "origine": "déduit", "ajouts": [], "à_vérifier": false,
      "note": "Le polycopié pose les questions sans donner de corrigé : résultats calculés avec les formules du cours (et ω = 2πf, manuscrite au ch04)."
    },
    {
      "id": "ch05.ex-bobine-tp",
      "titre": "Application numérique : la bobine de TP",
      "type": "exemple_cours",
      "enonce": "Bobine de TP : $L$ = 1,1 H, $r$ = 12 Ω, sous le réseau 230 V, 50 Hz. Calculer $Z$, $φ$ et $I$.",
      "donnees": [
        { "code": "L", "symbole": "L", "valeur": 1.1, "unite": "H" },
        { "code": "r", "symbole": "r", "valeur": 12, "unite": "Ω" },
        { "code": "V", "symbole": "V", "valeur": 230, "unite": "V" },
        { "code": "w", "symbole": "\\omega", "valeur": 314, "unite": "rad/s" }
      ],
      "etapes": [
        { "question": "Impédance Z ?", "formules": ["ch05.z-rl"], "calcul": "Math.sqrt(r*r+(L*w)*(L*w))", "reponse": { "valeur": 346, "unite": "Ω", "texte": "Z = √(12² + (1,1 × 314)²) = 346 Ω" } },
        { "question": "Déphasage φ ?", "formules": ["ch05.tan-rl"], "calcul": "Math.atan(L*w/r)*180/Math.PI", "reponse": { "valeur": 88, "unite": "°", "texte": "φ = arctan(1,1 × 314 / 12) = 88°" } },
        { "question": "Courant I ?", "formules": ["ch05.ohm-sinus"], "calcul": "V/Math.sqrt(r*r+(L*w)*(L*w))", "reponse": { "valeur": 0.667, "unite": "A", "texte": "I = V/Z = 230/346 = 0,667 A" } }
      ],
      "source": { "fichier": "A1-Ch05-p05.pdf", "page": 1, "zone": "annexe, § 7, application numérique" },
      "origine": "scan", "ajouts": [], "à_vérifier": false
    },
    {
