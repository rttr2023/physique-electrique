{
  "id": "ch05",
  "annee": 1,
  "numero": 5,
  "titre": "Modélisation des systèmes électriques",
  "sources": ["A1-Ch05-p01.pdf", "A1-Ch05-p02.pdf", "A1-Ch05-p03.pdf", "A1-Ch05-p04.pdf", "A1-Ch05-p05.pdf", "A1-Ch05-p06.pdf", "A1-Ch05-p07.pdf"],
  "objectifs": [
    "7.1 Savoir ce que modélise une résistance dans un schéma équivalent",
    "7.2 Savoir calculer la valeur efficace du courant traversant un dipôle, connaissant son impédance et la valeur efficace de la tension à ses bornes",
    "7.3 Connaître la valeur du déphasage et l'expression de l'impédance pour une résistance, une inductance pure (bobine idéale) et un condensateur idéal",
    "7.4 Connaître l'expression de l'impédance et du déphasage pour une association R, L série",
    "7.5 Savoir tracer la représentation de Fresnel correspondant à une relation"
  ],

  "notions": [
    {
      "id": "ch05.effet-resistif",
      "nom": "Effet résistif (effet Joule)",
      "definition": "Tout conducteur parcouru par un courant dégage une chaleur proportionnelle au carré de l'intensité. Ce dégagement de chaleur est modélisé par une résistance R : plus le système chauffe pour un courant donné, plus R est grande.",
      "source": { "fichier": "A1-Ch05-p02.pdf", "page": 1, "zone": "annexe, § 1" },
      "origine": "scan", "ajouts": [], "à_vérifier": false
    },
    {
      "id": "ch05.effet-inductif",
      "nom": "Effet inductif",
      "definition": "Un conducteur parcouru par un courant émet un champ magnétique. Quand il n'est pas négligeable (transformateur, machine tournante, câble à forte intensité…), l'induction crée un retard du courant sur la tension. Modélisé par une bobine idéale d'inductance L.",
      "source": { "fichier": "A1-Ch05-p02.pdf", "page": 1, "zone": "annexe, § 2" },
      "origine": "scan", "ajouts": [], "à_vérifier": false
    },
    {
      "id": "ch05.effet-capacitif",
      "nom": "Effet capacitif",
      "definition": "Phénomènes électrostatiques : accumulation momentanée d'électrons. En sinusoïdal, avance du courant sur la tension. Cas des condensateurs, mais aussi de deux câbles proches séparés par leurs gaines (« une sorte de condensateur »). Modélisé par un condensateur idéal de capacité C.",
      "source": { "fichier": "A1-Ch05-p02.pdf", "page": 1, "zone": "annexe, § 3" },
      "origine": "scan", "ajouts": [], "à_vérifier": false
    },
    {
      "id": "ch05.modele-cable",
      "nom": "Modèle d'un câble",
      "definition": "Un long câble (≈ 300 m) parcouru par un fort courant : pertes Joule → résistance R ; phénomènes magnétiques → inductance L. Si l'électrostatique est négligeable : R en série avec L. R et L se déterminent par une mesure de puissance en amont et en aval.",
      "source": { "fichier": "A1-Ch05-p02.pdf", "page": 1, "zone": "annexe, § 4 ; suite sur A1-Ch05-p03.pdf" },
      "origine": "scan", "ajouts": [], "à_vérifier": false
    },
    {
      "id": "ch05.impedance",
      "nom": "Impédance Z",
      "definition": "Pour un dipôle soumis à une tension sinusoïdale de valeur efficace V et traversé par un courant de valeur efficace I : Z = V/I, en ohms (Ω).",
      "source": { "fichier": "A1-Ch05-p03.pdf", "page": 1, "zone": "annexe, § 5" },
      "origine": "scan", "ajouts": [], "à_vérifier": false
    },
    {
      "id": "ch05.resistance-phase",
      "nom": "Résistance : en phase",
      "definition": "Pour une résistance, courant et tension sont en phase (φ = 0) : c'est le cas idéal au niveau du déphasage.",
      "source": { "fichier": "A1-Ch05-p03.pdf", "page": 1, "zone": "annexe, § 6, cas de la résistance" },
      "origine": "scan", "ajouts": [], "à_vérifier": false
    },
    {
      "id": "ch05.inductance-retard",
      "nom": "Inductance pure : courant en retard de 90°",
      "definition": "Pour une inductance pure (bobine idéale), le courant est en retard sur la tension : φ = 90° = π/2 rad.",
      "source": { "fichier": "A1-Ch05-p03.pdf", "page": 1, "zone": "annexe, § 6, cas de l'inductance pure" },
      "origine": "scan", "ajouts": [], "à_vérifier": false
    },
    {
      "id": "ch05.condensateur-avance",
      "nom": "Condensateur : courant en avance de 90°",
      "definition": "Pour un condensateur, le courant est en avance sur la tension : φ = −90° = −π/2 rad.",
      "source": { "fichier": "A1-Ch05-p04.pdf", "page": 1, "zone": "annexe, § 6, cas du condensateur" },
      "origine": "scan", "ajouts": [], "à_vérifier": false
    },
    {
      "id": "ch05.role-j",
      "nom": "Rôle de j en notation complexe",
      "definition": "Multiplier par j représente un angle de 90° entre I et V ; diviser par j représente un angle de −90°.",
      "source": { "fichier": "A1-Ch05-p04.pdf", "page": 1, "zone": "annexe, § 6, remarques" },
      "origine": "scan", "ajouts": [], "à_vérifier": false
    },
    {
      "id": "ch05.bobine-reelle",
      "nom": "Bobine réelle",
      "definition": "Une bobine réelle n'est pas idéale : ses pertes Joule sont modélisées par une résistance r en série avec l'inductance pure L (ex. bobines de TP : L = 1,1 H, r = 12 Ω).",
      "source": { "fichier": "A1-Ch05-p04.pdf", "page": 1, "zone": "annexe, § 7" },
      "origine": "scan", "ajouts": [], "à_vérifier": false
    },
    {
      "id": "ch05.methode-fresnel",
      "nom": "Méthode : déphasage et impédance d'un modèle",
      "definition": "On écrit la relation complexe (V = V_r + V_L = rI + jLωI), on trace la représentation de Fresnel (I origine des phases), puis trigonométrie (tan φ) et Pythagore (Z) dans le triangle rectangle.",
      "source": { "fichier": "A1-Ch05-p04.pdf", "page": 1, "zone": "annexe, § 7 ; triangle sur A1-Ch05-p05.pdf" },
      "origine": "scan", "ajouts": [], "à_vérifier": false
    },
    {
      "id": "ch05.etats-limites",
      "nom": "Condensateur et bobine à t = 0⁺ et t → ∞",
      "definition": "Juste après la fermeture (t = 0⁺), un condensateur déchargé se comporte comme un fil et une bobine sans courant comme un interrupteur ouvert. En régime permanent (t → ∞), c'est l'inverse : condensateur = circuit ouvert, bobine = fil.",
      "source": { "fichier": "A1-Ch05-p07.pdf", "page": 1, "zone": "exercices supplémentaires A et B (énoncés seulement)" },
      "origine": "hors_cours", "ajouts": ["méthode absente des scans (les exercices A et B n'ont ni cours ni corrigé) ; l'état t → ∞ rejoint le ch01 (condensateur = circuit ouvert, bobine = court-circuit en continu)"], "à_vérifier": true,
      "note": "Hors cours : à valider par Romain (ou par le professeur) avant utilisation dans le jeu."
    }
  ],

  "formules": [
    {
