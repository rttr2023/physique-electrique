      "origine": "scan", "ajouts": [], "à_vérifier": false
    },
    {
      "id": "ch06.piege-p-constante",
      "texte": "Un condensateur de relèvement ne change pas P : seuls Q, φ, S et I diminuent.",
      "lie_a": ["ch06.relevement"],
      "source": { "fichier": "A1-Ch06-p03.pdf", "page": 1, "zone": "documents 7 et 8" },
      "origine": "scan", "ajouts": [], "à_vérifier": false
    },
