  "exemples": [
    {
      "id": "ch06.ex-probleme",
      "titre": "Problématique : tension à appliquer en tête de ligne",
      "type": "exemple_cours",
      "enonce": "Une ligne de 500 m ($r$ : 0,14 mΩ/m ; $l$ : 2·10⁻⁷ H/m) alimente le primaire d'un transformateur modélisé par $R$ = 0,2 Ω en série, puis $R_f$ = 605 Ω, $L$ = 0,28 H et $R_{charge}$ = 1,07 Ω en dérivation sous $V_2$ = 230 V. Courant en ligne : 200 A ; $f$ = 50 Hz. 2.1 Calculer $r$ et $l$. 2.2 Par la méthode de Boucherot, calculer $V_1$.",
      "donnees": [
        { "code": "rm", "symbole": "r_{/m}", "valeur": 0.00014, "unite": "Ω/m" },
        { "code": "lm", "symbole": "l_{/m}", "valeur": 2e-7, "unite": "H/m" },
        { "code": "long", "symbole": "\\ell", "valeur": 500, "unite": "m" },
        { "code": "R", "symbole": "R", "valeur": 0.2, "unite": "Ω" },
        { "code": "L", "symbole": "L", "valeur": 0.28, "unite": "H" },
        { "code": "Rf", "symbole": "R_f", "valeur": 605, "unite": "Ω" },
        { "code": "Rch", "symbole": "R_{charge}", "valeur": 1.07, "unite": "Ω" },
        { "code": "V2", "symbole": "V_2", "valeur": 230, "unite": "V" },
        { "code": "I", "symbole": "I", "valeur": 200, "unite": "A" },
        { "code": "w", "symbole": "\\omega", "valeur": 314.16, "unite": "rad/s" }
      ],
      "etapes": [
        { "question": "Résistance r de la ligne ?", "formules": [], "calcul": "rm*long", "reponse": { "valeur": 0.07, "unite": "Ω", "texte": "r = 0,14 × 10⁻³ × 500 = 0,07 Ω" } },
        { "question": "Inductance l de la ligne ?", "formules": [], "calcul": "lm*long", "reponse": { "valeur": 0.0001, "unite": "H", "texte": "l = 2 × 10⁻⁷ × 500 = 0,1 mH" } },
        { "question": "Étape 1 : P_T ?", "formules": ["ch06.p-r-v", "ch06.p-r-i", "ch06.boucherot-p"], "calcul": "V2*V2/Rf + V2*V2/Rch + (R+rm*long)*I*I", "reponse": { "valeur": 60326, "unite": "W", "texte": "P_T = 230²/605 + 230²/1,07 + (0,2 + 0,07) × 200² ≈ 60,3 kW" } },
        { "question": "Étape 2 : Q_T ?", "formules": ["ch06.q-l-v", "ch06.q-l-i", "ch06.boucherot-q"], "calcul": "V2*V2/(L*w) + lm*long*w*I*I", "reponse": { "valeur": 1858, "unite": "VAR", "texte": "Q_T = 230²/(0,28 × 314) + 0,1·10⁻³ × 314 × 200² ≈ 1,86 kVAR" } },
        { "question": "Étape 3 : S_T ?", "formules": ["ch06.st"], "calcul": "Math.sqrt(Math.pow(V2*V2/Rf + V2*V2/Rch + (R+rm*long)*I*I,2)+Math.pow(V2*V2/(L*w) + lm*long*w*I*I,2))", "reponse": { "valeur": 60355, "unite": "VA", "texte": "S_T ≈ 60,4 kVA" } },
        {
          "question": "Étape 4 : V_1 ?", "formules": ["ch06.s"], "calcul": "Math.sqrt(Math.pow(V2*V2/Rf + V2*V2/Rch + (R+rm*long)*I*I,2)+Math.pow(V2*V2/(L*w) + lm*long*w*I*I,2))/I",
          "reponse": { "valeur": 301.8, "unite": "V", "texte": "V_1 = S_T / I ≈ 302 V" },
          "à_vérifier": true,
          "note": "Données incohérentes dans l'énoncé : sous V_2 = 230 V, R_charge = 1,07 Ω absorbe déjà 230/1,07 ≈ 215 A, plus que les 200 A annoncés en ligne. Le résultat (302 V) applique la méthode aux données telles quelles ; à comparer à la correction du professeur."
        }
      ],
      "source": { "fichier": "A1-Ch06-p04.pdf", "page": 1, "zone": "problématique ; données et questions sur A1-Ch06-p05.pdf" },
      "origine": "déduit", "ajouts": [], "à_vérifier": false,
      "note": "Pas de corrigé dans le polycopié : résolution faite avec les formules du cours. La question subsidiaire (dimensionnement de la section par la chute de tension) relève du cours d'électrotechnique et n'est pas traitée."
    },
    {
      "id": "ch06.td-ex1",
      "titre": "TD exercice 1 — Dimensionnement électrique d'un atelier",
      "type": "td",
      "enonce": "Un atelier ($P$ = 30 kW ; $Q$ = 22,5 kVAR) est alimenté sous 230 V, 50 Hz par un câble de 700 m ($r$ : 7,8·10⁻⁵ Ω/m ; $l$ : 2,39·10⁻⁷ H/m) depuis le secondaire d'un transformateur. 1. $S$ côté atelier ? 2. $I$ en ligne ? 3. $V_s$ par Boucherot ?",
      "donnees": [
        { "code": "P", "symbole": "P", "valeur": 30000, "unite": "W" },
        { "code": "Q", "symbole": "Q", "valeur": 22500, "unite": "VAR" },
        { "code": "V", "symbole": "V", "valeur": 230, "unite": "V" },
        { "code": "rm", "symbole": "r_{/m}", "valeur": 7.8e-5, "unite": "Ω/m" },
        { "code": "lm", "symbole": "l_{/m}", "valeur": 2.39e-7, "unite": "H/m" },
        { "code": "long", "symbole": "\\ell", "valeur": 700, "unite": "m" },
        { "code": "w", "symbole": "\\omega", "valeur": 314.16, "unite": "rad/s" }
      ],
      "etapes": [
        { "question": "Puissance apparente S côté atelier ?", "formules": ["ch06.s2"], "calcul": "Math.sqrt(P*P+Q*Q)", "reponse": { "valeur": 37500, "unite": "VA", "texte": "S = 37,5 kVA" } },
        { "question": "Courant en ligne I ?", "formules": ["ch06.s"], "calcul": "Math.sqrt(P*P+Q*Q)/V", "reponse": { "valeur": 163, "unite": "A", "texte": "I = 163 A" } },
        { "question": "Tension V_s du secondaire ?", "formules": ["ch06.n-methode-boucherot", "ch06.p-r-i", "ch06.q-l-i", "ch06.st"], "calcul": "Math.sqrt(Math.pow(P+rm*long*Math.pow(Math.sqrt(P*P+Q*Q)/V,2),2)+Math.pow(Q+lm*long*w*Math.pow(Math.sqrt(P*P+Q*Q)/V,2),2))/(Math.sqrt(P*P+Q*Q)/V)", "reponse": { "valeur": 242, "unite": "V", "texte": "V_s = 242 V" } }
      ],
      "source": { "fichier": "A1-Ch06-p08.pdf", "page": 1, "zone": "TD, exercice 1 ; réponses sur A1-Ch06-p09.pdf" },
      "origine": "scan", "ajouts": [], "à_vérifier": false
    },
    {
      "id": "ch06.td-ex2",
      "titre": "TD exercice 2 — Schéma monophasé équivalent d'une installation triphasée",
      "type": "td",
      "enonce": "Sous $V$ = 230 V, 50 Hz : un condensateur $C$ = 470 µF en dérivation avec une branche $R$ = 3,33 Ω en série avec $L$ = 13,3 mH (courant $I_1$). 1. Calculer $I_1$ par un calcul d'impédance. 2. En déduire $I$ par Boucherot. 3. Courant en ligne sans le condensateur ?",
      "donnees": [
        { "code": "C", "symbole": "C", "valeur": 0.00047, "unite": "F" },
        { "code": "R", "symbole": "R", "valeur": 3.33, "unite": "Ω" },
        { "code": "L", "symbole": "L", "valeur": 0.0133, "unite": "H" },
        { "code": "V", "symbole": "V", "valeur": 230, "unite": "V" },
        { "code": "w", "symbole": "\\omega", "valeur": 314.16, "unite": "rad/s" }
      ],
