  "pieges": [
    {
      "id": "ch06.piege-boucherot-s",
      "texte": "Le théorème de Boucherot n'est PAS valable pour S : on n'additionne jamais les puissances apparentes. S_T = √(P_T² + Q_T²).",
      "lie_a": ["ch06.st", "ch06.boucherot-p", "ch06.boucherot-q"],
      "source": { "fichier": "A1-Ch06-p02.pdf", "page": 1, "zone": "document 6, encadré d'avertissement" },
      "origine": "scan", "ajouts": [], "à_vérifier": false
    },
    {
      "id": "ch06.piege-unites",
      "texte": "Unités : P en W, Q en VAR, S en VA. Ne jamais exprimer S en watts.",
      "lie_a": ["ch06.p", "ch06.q", "ch06.s"],
      "source": { "fichier": "A1-Ch06-p01.pdf", "page": 1, "zone": "documents 2, 3 et 5" },
      "origine": "scan", "ajouts": [], "à_vérifier": false
    },
    {
      "id": "ch06.piege-k-cos",
      "texte": "k = cos φ uniquement en régime sinusoïdal ; la définition générale est k = P/S.",
      "lie_a": ["ch06.k", "ch06.k-cos"],
      "source": { "fichier": "A1-Ch06-p02.pdf", "page": 1, "zone": "document 4" },
      "origine": "scan", "ajouts": [], "à_vérifier": false
    },
    {
      "id": "ch06.piege-qc-negatif",
      "texte": "La puissance réactive d'un condensateur est négative (il en fournit) : ne pas oublier le signe − dans la somme des Q.",
      "lie_a": ["ch06.q-c-i", "ch06.q-c-v", "ch06.boucherot-q"],
      "source": { "fichier": "A1-Ch06-p07.pdf", "page": 1, "zone": "tableau récapitulatif ; Q_C < 0 sur A1-Ch06-p03.pdf" },
      "origine": "scan", "ajouts": [], "à_vérifier": false
    },
    {
      "id": "ch06.piege-i-ou-v",
      "texte": "En série, utiliser les expressions en fonction de I ; en dérivation, en fonction de V (on connaît la grandeur commune).",
      "lie_a": ["ch06.p-r-i", "ch06.p-r-v", "ch06.q-l-i", "ch06.q-l-v", "ch06.q-c-i", "ch06.q-c-v"],
