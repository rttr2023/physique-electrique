{
  "id": "ch06",
  "annee": 1,
  "numero": 6,
  "titre": "Les puissances en régime sinusoïdal",
  "sources": ["A1-Ch06-p01.pdf", "A1-Ch06-p02.pdf", "A1-Ch06-p03.pdf", "A1-Ch06-p04.pdf", "A1-Ch06-p05.pdf", "A1-Ch06-p06.pdf", "A1-Ch06-p07.pdf", "A1-Ch06-p08.pdf", "A1-Ch06-p09.pdf"],
  "objectifs": [
    "8.1 Connaître les noms, les expressions et les unités des puissances p, P, Q et S",
    "8.2 Connaître la relation entre P, Q et S",
    "8.3 Savoir calculer Q connaissant P et le facteur de puissance",
    "8.4 Connaître les différentes relations des puissances P et Q pour une résistance, une inductance pure et un condensateur",
    "8.5 Savoir dans quel cas on utilise une des précédentes relations plutôt qu'une autre",
    "8.6 Connaître le théorème de Boucherot",
    "8.7 Savoir utiliser la méthode de Boucherot pour déterminer une valeur efficace de tension ou de courant dans une installation"
  ],

  "notions": [
    {
      "id": "ch06.n-instantanee",
      "nom": "Puissance instantanée p",
      "definition": "p = v(t) × i(t), reçue par le dipôle en convention récepteur. p > 0 : le dipôle reçoit ; p < 0 : il fournit. Même si u et i ont une moyenne nulle, la moyenne de p est généralement non nulle.",
      "source": { "fichier": "A1-Ch06-p01.pdf", "page": 1, "zone": "document 1" },
      "origine": "scan", "ajouts": [], "à_vérifier": false
    },
    {
      "id": "ch06.n-active",
      "nom": "Puissance active P",
      "definition": "Valeur moyenne de la puissance instantanée, en watts (W). Elle est liée à la quantité d'énergie électrique absorbée par un système.",
      "source": { "fichier": "A1-Ch06-p01.pdf", "page": 1, "zone": "document 2" },
      "origine": "scan", "ajouts": [], "à_vérifier": false
    },
    {
      "id": "ch06.n-apparente",
      "nom": "Puissance apparente S",
      "definition": "Produit des valeurs efficaces V × I, en V.A. Elle ne représente aucune puissance réelle (d'où l'unité VA et non W) mais sert au dimensionnement des installations.",
      "source": { "fichier": "A1-Ch06-p01.pdf", "page": 1, "zone": "document 3" },
      "origine": "scan", "ajouts": [], "à_vérifier": false
    },
    {
      "id": "ch06.n-facteur",
      "nom": "Facteur de puissance k",
      "definition": "k = P/S, sans unité, valable dans tous les régimes. En sinusoïdal seulement, k = cos φ. On en déduit k ≤ 1 ; un bon facteur de puissance est proche de 1.",
      "source": { "fichier": "A1-Ch06-p02.pdf", "page": 1, "zone": "document 4" },
      "origine": "scan", "ajouts": [], "à_vérifier": false
    },
    {
      "id": "ch06.n-mauvais-facteur",
      "nom": "Conséquences d'un mauvais facteur de puissance",
      "definition": "I = P/(V cos φ) : plus cos φ est petit, plus le courant est grand pour la même puissance active. D'où un coût d'installation plus élevé (conducteurs plus gros), plus de pertes en ligne et des surtaxes du fournisseur.",
      "source": { "fichier": "A1-Ch06-p02.pdf", "page": 1, "zone": "document 4" },
      "origine": "scan", "ajouts": [], "à_vérifier": false
    },
    {
      "id": "ch06.n-reactive",
      "nom": "Puissance réactive Q",
      "definition": "Puissance liée à la présence d'un déphasage, donc à la qualité de l'énergie. Unité : VAR (volt-ampère réactif). Définie en sinusoïdal par S² = P² + Q².",
      "source": { "fichier": "A1-Ch06-p02.pdf", "page": 1, "zone": "document 5" },
      "origine": "scan", "ajouts": [], "à_vérifier": false
    },
    {
      "id": "ch06.n-triangle",
      "nom": "Triangle des puissances",
      "definition": "Triangle rectangle de côtés P (horizontal), Q (vertical) et S (hypoténuse), avec l'angle φ entre P et S. Circuit inductif : Q vers le haut ; circuit capacitif : Q vers le bas.",
      "source": { "fichier": "A1-Ch06-p02.pdf", "page": 1, "zone": "document 5, figures" },
      "origine": "scan", "ajouts": [], "à_vérifier": false
    },
    {
      "id": "ch06.n-boucherot",
      "nom": "Théorème de Boucherot",
      "definition": "La puissance active fournie par le générateur est égale à la somme des puissances actives consommées par chaque récepteur ; de même pour la puissance réactive. Pas valable pour les puissances apparentes.",
      "source": { "fichier": "A1-Ch06-p02.pdf", "page": 1, "zone": "document 6" },
      "origine": "scan", "ajouts": [], "à_vérifier": false
    },
    {
      "id": "ch06.n-relevement",
      "nom": "Relever le facteur de puissance",
      "definition": "Les installations inductives (moteurs) consomment de la puissance réactive : on ajoute un élément qui en fournit. 2 solutions : batterie de condensateurs, ou moteur synchrone surexcité à vide (compensateur synchrone).",
      "source": { "fichier": "A1-Ch06-p03.pdf", "page": 1, "zone": "document 7" },
      "origine": "scan", "ajouts": [], "à_vérifier": false
    },
    {
      "id": "ch06.n-effet-relevement",
      "nom": "Effet du condensateur de relèvement",
      "definition": "Condensateur en dérivation sur le dipôle inductif : P' = P et Q' = Q + Q_C avec Q_C < 0, donc Q' < Q. φ diminue, cos φ augmente, I' < I : même puissance active avec moins de courant en ligne.",
      "source": { "fichier": "A1-Ch06-p03.pdf", "page": 1, "zone": "document 7, après relèvement" },
      "origine": "scan", "ajouts": [], "à_vérifier": false
    },
    {
      "id": "ch06.n-p-constante",
      "nom": "P inchangée par la batterie",
      "definition": "L'ajout d'une batterie de condensateurs ne modifie pas la puissance active d'une installation : même P avant et après redressement.",
      "source": { "fichier": "A1-Ch06-p03.pdf", "page": 1, "zone": "document 8" },
      "origine": "scan", "ajouts": [], "à_vérifier": false
    },
    {
      "id": "ch06.n-choix-relation",
      "nom": "En fonction de I ou de V ?",
      "definition": "En série (même courant) : expressions en fonction de I. En dérivation (même tension) : expressions en fonction de V.",
      "source": { "fichier": "A1-Ch06-p07.pdf", "page": 1, "zone": "annexe, § 3" },
      "origine": "scan", "ajouts": [], "à_vérifier": false
    },
    {
      "id": "ch06.n-methode-boucherot",
      "nom": "Méthode de Boucherot (4 étapes)",
      "definition": "Calculer V ou I à l'entrée d'un système par les puissances, sans complexes : 1) P_T = somme des P de chaque résistance ; 2) Q_T = somme des Q de chaque bobine et condensateur ; 3) S_T = √(P_T² + Q_T²) ; 4) S_T = V × I (monophasé) donne V ou I.",
      "source": { "fichier": "A1-Ch06-p07.pdf", "page": 1, "zone": "annexe, § 4" },
      "origine": "scan", "ajouts": [], "à_vérifier": false
    }
  ],

  "formules": [
    {
      "id": "ch06.p-inst", "site_id": "pinst",
      "nom": "Puissance instantanée",
      "latex": "p = v(t) \\times i(t)",
      "variables": [
        { "symbole": "p", "code": "p", "signification": "puissance instantanée reçue", "unite": "W" },
        { "symbole": "v(t)", "code": "v", "signification": "tension instantanée", "unite": "V" },
        { "symbole": "i(t)", "code": "i", "signification": "courant instantané", "unite": "A" }
      ],
      "conditions": "Convention récepteur.",
      "calcul": { "cible": "p", "expression": "v*i" },
      "source": { "fichier": "A1-Ch06-p01.pdf", "page": 1, "zone": "document 1, encadré" },
      "origine": "scan", "ajouts": ["unités : non écrites dans le document 1"], "à_vérifier": false
    },
    {
      "id": "ch06.p", "site_id": "P",
      "nom": "Puissance active",
      "latex": "P = V I \\cos\\varphi",
      "variables": [
        { "symbole": "P", "code": "P", "signification": "puissance active", "unite": "W" },
        { "symbole": "V", "code": "V", "signification": "tension efficace", "unite": "V" },
        { "symbole": "I", "code": "I", "signification": "courant efficace", "unite": "A" },
        { "symbole": "\\varphi", "code": "phi", "signification": "déphasage", "unite": "rad" }
      ],
      "conditions": "Régime sinusoïdal. Valeur moyenne de p.",
      "calcul": { "cible": "P", "expression": "V*I*Math.cos(phi)" },
